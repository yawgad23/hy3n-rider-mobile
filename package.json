{
  "name": "app-template",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "node ./node_modules/.bin/cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 node ./node_modules/.bin/expo start --web --port ${EXPO_PORT:-8081}",
    "check": "tsc --noEmit",
    "check:apple-native": "node scripts/check-apple-auth-integration.mjs",
    "eas-build-post-install": "node scripts/patch-apple-authentication.mjs && node scripts/check-apple-auth-integration.mjs",
    "test": "vitest run",
    "lint": "expo lint",
    "format": "prettier --write .",
    "android": "node ./node_modules/.bin/cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 node ./node_modules/.bin/expo start --android",
    "ios": "node ./node_modules/.bin/cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 node ./node_modules/.bin/expo start --ios",
    "qr": "node scripts/generate_qr.mjs",
    "postinstall": "node scripts/patch-expo-live-activity.mjs && node scripts/patch-apple-authentication.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.18",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "25.1.0",
    "@react-native-firebase/messaging": "25.1.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@tanstack/react-query": "^5.90.12",
    "@trpc/client": "11.7.2",
    "@trpc/react-query": "11.7.2",
    "@trpc/server": "11.7.2",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "expo": "~57.0.33",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.21",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.23",
    "expo-constants": "~57.0.24",
    "expo-contacts": "~57.0.9",
    "expo-crypto": "~57.0.4",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.21",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.14",
    "expo-live-activity": "0.4.2",
    "expo-local-authentication": "~57.0.3",
    "expo-location": "~57.0.23",
    "expo-notifications": "~57.0.25",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.31",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.26",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.15.0",
    "hy3n-backend": "github:yawgad23/backend#275b227a2ddeb2db157b1f6b061ffeea312e6ea1",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "superjson": "^1.13.3",
    "tailwind-merge": "^2.6.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^22.19.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.17",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.7.4",
    "qrcode": "^1.5.4",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "vitest": "2.1.9"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "@trpc/server": "11.7.2"
    }
  },
  "expo": {
    "install": {
      "exclude": []
    }
  }
}
