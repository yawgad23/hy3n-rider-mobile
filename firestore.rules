// Canonical deployment source: /home/ubuntu/backend-restored/firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.token.email == 'yawgad23@gmail.com'; }
    function isAdmin() { return isOwner() || (signedIn() && exists(/databases/$(database)/documents/admin_access/$(request.auth.token.email)) && get(/databases/$(database)/documents/admin_access/$(request.auth.token.email)).data.is_active == true); }
    function isSelf(field) { return signedIn() && resource.data[field] == request.auth.uid; }
    function isNewSelf(field) { return signedIn() && request.resource.data[field] == request.auth.uid; }
    function isRideParticipant() { return signedIn() && (resource.data.rider_id == request.auth.uid || resource.data.driver_id == request.auth.uid); }
    match /driver_profiles/{id} { allow read: if isAdmin() || isSelf('user_id'); allow create: if isAdmin() || isNewSelf('user_id'); allow update, delete: if isAdmin() || isSelf('user_id'); }
    match /driver_presence/{id} { allow read: if signedIn(); allow write: if false; }
    match /rider_profiles/{id} { allow read, update, delete: if isAdmin() || isSelf('user_id'); allow create: if isAdmin() || isNewSelf('user_id'); }
    match /wallets/{id} { allow read: if signedIn() && request.auth.uid == id; allow write: if false; }
    match /wallet_transactions/{id} { allow read: if isSelf('user_id'); allow write: if false; }
    match /rides/{id} { allow read: if isAdmin() || isRideParticipant(); allow create, delete: if isAdmin(); allow update: if isAdmin() || (isRideParticipant() && resource.data.rider_id == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rider_rating','rider_feedback','rider_feedback_tags','rated_at','updated_date'])); }
    match /ride_messages/{id} { allow read: if isAdmin() || (signedIn() && (resource.data.rider_id == request.auth.uid || resource.data.driver_id == request.auth.uid || resource.data.sender_id == request.auth.uid)); allow create: if isAdmin() || (signedIn() && request.resource.data.sender_id == request.auth.uid); allow update: if isAdmin() || (signedIn() && (resource.data.rider_id == request.auth.uid || resource.data.driver_id == request.auth.uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['delivered_to_rider','delivered_to_driver','read_by_rider','read_by_driver','read_at','updated_date'])); allow delete: if isAdmin(); }
    match /support_tickets/{id} { allow read: if isAdmin() || isSelf('user_id') || isSelf('driver_id') || isSelf('rider_id'); allow create: if signedIn(); allow update, delete: if isAdmin(); }
    match /sos_incidents/{id} { allow read: if isAdmin() || isSelf('user_id') || isSelf('driver_id') || isSelf('rider_id'); allow create: if signedIn(); allow update, delete: if isAdmin(); }
    match /ride_reports/{id} { allow read: if isAdmin() || isSelf('rider_id') || isSelf('driver_id'); allow create: if signedIn() && (request.resource.data.rider_id == request.auth.uid || request.resource.data.driver_id == request.auth.uid); allow update, delete: if isAdmin(); }
    match /admin_access/{id} { allow read: if isAdmin() || (signedIn() && request.auth.token.email == id); allow write: if isOwner(); }
    match /{document=**} { allow read, write: if false; }
  }
}
